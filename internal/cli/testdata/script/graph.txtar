# graph in every format (US4).
exec lockinaudit inspect $FIXTURES/shop-aws --include-drafts --as-of 2026-10-06 --repo-name shop-aws --emoji never --no-color

exec lockinaudit graph --no-color
stdout '^Dependency tree \([0-9]+ nodes, [0-9]+ edges\)'
stdout 'aws_dynamodb_table\.orders'

exec lockinaudit graph aws_dynamodb_table.orders --blast-radius --no-color
stdout '^Blast radius of aws_dynamodb_table\.orders +dependents: [0-9]+'

exec lockinaudit graph --waves --no-color
stdout '\[wave [0-9]+\]'

exec lockinaudit graph --expand --no-color
stdout 'aws_subnet\.a'

exec lockinaudit graph --format dot
stdout '^digraph'

exec lockinaudit graph --format json
stdout '"kind": "graph"'

exec lockinaudit graph --format svg -o g.svg
stdout 'wrote g.svg'
exists g.svg

exec lockinaudit graph --format png -o g.png
exists g.png

! exec lockinaudit graph --format png
stderr 'needs -o'

! exec lockinaudit graph --format bmp
stderr 'unknown --format'

! exec lockinaudit graph aws_dynamodb_table.ordrs
stderr 'did you mean'

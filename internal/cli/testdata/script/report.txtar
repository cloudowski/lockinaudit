# reports in every format (US3).
exec lockinaudit inspect $FIXTURES/shop-aws --include-drafts --as-of 2026-10-06 --repo-name shop-aws --emoji never --no-color

exec lockinaudit report
stdout 'wrote lockinaudit-report\.html'
grep '<html' lockinaudit-report.html
grep 'Exit Readiness' lockinaudit-report.html
! grep '<script src=' lockinaudit-report.html
! grep '<link [^>]*href="http' lockinaudit-report.html

exec lockinaudit report --format md -o r.md
grep '^# ' r.md
grep 'Exit Readiness' r.md

exec lockinaudit report --format json -o r.json
grep '"format": "lockinaudit.result/v1"' r.json

! exec lockinaudit report --format pdf
stderr 'unknown --format'

! exec lockinaudit report --input missing.json
stderr 'missing.json'

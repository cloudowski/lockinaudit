# version layout and json (US9).
exec lockinaudit version
stdout '^lockinaudit +\S+$'
stdout '^catalog +[0-9]{4}\.[0-9]{2}\.[0-9]+ \(schema [0-9]+\.[0-9]+\)$'
stdout '^rules +[0-9]+\.[0-9]+\.[0-9]+$'
stdout '^result format +lockinaudit\.result/v1$'

exec lockinaudit version --format json
stdout '"result_format": "lockinaudit.result/v1"'
stdout '"catalog_schema": "'

exec lockinaudit inspect $FIXTURES/shop-aws --include-drafts --as-of 2026-10-06 --repo-name shop-aws --format json --no-store
stdout '"rules": "'

! exec lockinaudit version --format yaml
stderr 'unknown --format'
